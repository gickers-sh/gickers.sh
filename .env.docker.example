# Docker deployment settings for gickers.sh — copy to `.env.docker` and edit.
# Used only by `make docker-*` (docker compose --env-file .env.docker).
# The host `make run` ignores this file.

# Symfony (use dev + APP_DEBUG=1 for local development with live reload, prod for production)
APP_ENV=prod
APP_DEBUG=0
# Generate one: `php -r "echo bin2hex(random_bytes(16));"`
APP_SECRET=change-me

# Postgres
POSTGRES_USER=gickers
POSTGRES_PASSWORD=gickers
POSTGRES_DB=gickers

# Host port mapping (configurable)
HTTP_PORT=80
HTTPS_PORT=443
SSH_PORT=22

# Public domain and URLs advertised to clients (production deployment target: gits.run)
APP_DOMAIN=gits.run
SOFT_SERVE_HTTP_PUBLIC_URL=https://gits.run
SOFT_SERVE_SSH_PUBLIC_URL=ssh://gits.run

# Caddy TLS (empty in production for Let's Encrypt auto-HTTPS, set for local mkcert)
CADDY_TLS=""

# Server policy (brand & display name: Gickers.sh)
SOFT_SERVE_NAME=Gickers.sh
SOFT_SERVE_LFS_ENABLED=true
SOFT_SERVE_ANON_ACCESS=read-only
SOFT_SERVE_ALLOW_KEYLESS=true
# First admin's SSH public key (whole line, quoted)
SOFT_SERVE_INITIAL_ADMIN_KEYS=
SOFT_SERVE_WEBHOOK_ALLOW_LIST=

# Isolated Deploy Engine (Docker-in-Docker with gVisor sandbox & anti-SSRF firewall)
# Can also point to an external dedicated VM (e.g. DOCKER_HOST=tcp://10.x.x.x:2375 and DEPLOY_GATEWAY_HOST=10.x.x.x)
DOCKER_HOST=tcp://deploy-dockerd:2375
DEPLOY_GATEWAY_HOST=deploy-dockerd
DEPLOY_DOCKER_RUNTIME=runsc
DEPLOY_GVISOR_PLATFORM=systrap
