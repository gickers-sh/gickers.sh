# Docker deployment settings for codes.sh — copy to `.env.docker` and edit.
# Used only by `make docker-*` (docker compose --env-file .env.docker).
# The host `make run` ignores this file.

# Symfony (use dev + APP_DEBUG=1 for local development with live reload, prod for production)
APP_ENV=dev
APP_DEBUG=1
# Generate one: `php -r "echo bin2hex(random_bytes(16));"`
APP_SECRET=change-me

# Postgres
POSTGRES_USER=codes
POSTGRES_PASSWORD=codes
POSTGRES_DB=codes

# Host port mapping (configurable)
HTTP_PORT=80
HTTPS_PORT=443
SSH_PORT=2223

# Public URLs advertised to clients (add codes.sh to /etc/hosts -> 127.0.0.1)
SOFT_SERVE_HTTP_PUBLIC_URL=https://codes.sh
SOFT_SERVE_SSH_PUBLIC_URL=ssh://codes.sh:2223

# Caddy TLS (empty in production for Let's Encrypt auto-HTTPS, set for local mkcert)
CADDY_TLS="tls /app/codes.sh+1.pem /app/codes.sh+1-key.pem"

# Server policy
SOFT_SERVE_NAME=Codes.sh
SOFT_SERVE_LFS_ENABLED=true
SOFT_SERVE_ANON_ACCESS=read-only
SOFT_SERVE_ALLOW_KEYLESS=true
# First admin's SSH public key (whole line, quoted)
SOFT_SERVE_INITIAL_ADMIN_KEYS=
SOFT_SERVE_WEBHOOK_ALLOW_LIST=
