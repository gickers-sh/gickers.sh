{% import 'macros/ui.html.twig' as ui %}
<div class="doc-terminal{% if class is defined and class %} {{ class }}{% endif %}">
    <div class="doc-terminal-bar">
        <div class="doc-terminal-header-left">
            {% include 'components/terminal_dots.html.twig' %}
            <span class="doc-terminal-title">{{ title }}</span>
        </div>
        {% if copy_text is defined and copy_text %}
            {{ ui.copy_btn(copy_text, copy_label|default('Copy'), copy_class|default(''), copy_title|default('Copy to clipboard')) }}
        {% endif %}
    </div>
    <div class="doc-terminal-body"{% if body_style is defined and body_style %} style="{{ body_style }}"{% endif %}>
        {{ body|raw }}
    </div>
</div>
