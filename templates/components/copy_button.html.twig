<button type="button" class="copy-btn{% if class is defined and class %} {{ class }}{% endif %}{% if label is not defined or not label %} copy-btn-icon-only{% endif %}" data-copy="{{ text }}" aria-label="{{ aria_label | default(title | default('Copy to clipboard')) }}" title="{{ title | default('Copy to clipboard') }}">
    <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
    <svg class="check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
    {% if label is defined and label %}<span class="copy-label">{{ label }}</span>{% endif %}
</button>
