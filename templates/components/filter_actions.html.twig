<div class="cli-filter-actions">
    <input type="search" class="cli-search" placeholder="{{ placeholder|default('Filter commands...') }}" aria-label="{{ aria_label|default('Filter commands') }}">
    <div class="cli-view-toggle" role="group" aria-label="View layout">
        <button type="button" class="cli-view-btn active" data-view="grid" title="Cards layout">Cards</button>
        <button type="button" class="cli-view-btn" data-view="list" title="Compact list layout">List</button>
    </div>
</div>
