{% macro copy_btn(text, label = null, class = '', title = 'Copy to clipboard', aria_label = null) %}
    {% set aria = aria_label ?? title %}
    <button type="button" class="copy-btn{% if class %} {{ class }}{% endif %}{% if not label %} copy-btn-icon-only{% endif %}" data-copy="{{ text }}" aria-label="{{ aria }}" title="{{ title }}">
        <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <svg class="check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        {% if label %}<span class="copy-label">{{ label }}</span>{% endif %}
    </button>
{% endmacro %}

{% macro user_nav(currentUsername, sshPrefix, page = 'home') %}
    <div class="home-user-nav">
        {% if page != 'docs' %}
            <a href="/docs" class="home-btn" title="View complete CLI documentation">CLI Docs</a>
        {% endif %}
        {% if page != 'home' %}
            <a href="/" class="home-btn" title="Back to repositories list">&larr; Repositories</a>
        {% endif %}
        {% if currentUsername %}
            <div class="user-pill">
                <span class="user-pill-label">Signed in as</span>
                <a href="/@{{ currentUsername }}" class="user-pill-name">@{{ currentUsername }}</a>
            </div>
            {% if page != 'user_repos' %}
                <a href="/@{{ currentUsername }}" class="home-btn">My Repositories &rarr;</a>
            {% endif %}
            <a href="/logout" class="home-btn home-btn-subtle" title="Sign out of web session">Log out</a>
        {% else %}
            <div class="user-pill user-pill-anon">
                <span class="user-pill-label">Terminal login</span>
                <code>{{ sshPrefix }} web login</code>
                {{ _self.copy_btn(sshPrefix ~ ' web login', null, 'copy-btn-sm', 'Copy login command') }}
            </div>
        {% endif %}
    </div>
{% endmacro %}
