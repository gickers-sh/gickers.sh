<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My Repositories - {{ serverName }}</title>
    <link rel="stylesheet" href="/css/repo-web.css">
</head>
<body>
<main>
    <header class="repo-head">
        <div class="identity">
            <h1>My Repositories</h1>
            {% if username %}
                <p class="description">Signed in as <strong>{{ username }}</strong> on {{ serverName }}.</p>
            {% else %}
                <p class="description">{{ serverName }}</p>
            {% endif %}
        </div>
    </header>

    {% if username is null %}
        <section class="section active">
            <p class="notice">You are not signed in to this browser.</p>
            <p class="cli-login-hint">Run <a href="ssh://{{ sshPrefix }} web login"><code>{{ sshPrefix }} web login</code></a> over SSH, then open the link it prints to sign in. Your repositories will appear here.</p>
        </section>
    {% elseif repositories is empty %}
        <section class="section active">
            <p class="notice">You don't own or collaborate on any repositories yet.</p>
            <p class="cli-login-hint">Create one with <code>{{ sshPrefix }} repo create &lt;name&gt;</code>.</p>
        </section>
    {% else %}
        <section class="section active" aria-label="My repositories">
            <ul class="repo-list">
                {% for repo in repositories %}
                    <li class="repo-list-item">
                        <a class="repo-list-link" href="/{{ repo.name }}">{{ repo.name }}</a>
                        <span class="repo-list-badges">
                            <span class="cli-tier cli-tier-role">{{ repo.role }}</span>
                            {% if repo.private %}<span class="cli-tier cli-tier-admin">private</span>{% endif %}
                            {% if repo.hidden %}<span class="cli-tier cli-tier-write">hidden</span>{% endif %}
                        </span>
                        {% if repo.description is not empty %}<span class="repo-list-desc">{{ repo.description }}</span>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <footer class="status"><span class="status-name">{{ username ?? serverName }}</span><span class="status-summary">{{ repositories|length }} repositor{{ repositories|length == 1 ? 'y' : 'ies' }}</span><span class="status-meta">HTTP · {{ serverName }}</span></footer>
</main>
</body>
</html>
