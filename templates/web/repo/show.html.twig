{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}{{ repository }} - {{ serverName }}{% endblock %}

{% set nav_page = 'repo' %}

{% block header_identity %}
    <div class="repo-breadcrumb">
        <a href="/" class="breadcrumb-link"><span class="cli-prompt">&gt;_</span> {{ serverName }}</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{{ repository }}</span>
    </div>
    <h1>{{ repository }}</h1>
    {% if description is not empty %}<p class="description">{{ description }}</p>{% endif %}
{% endblock %}

{% block main %}
    {% if cloneCommand is not empty %}
        {% include 'components/clone_bar.html.twig' with {
            label: 'Clone',
            command: cloneCommand,
            btn_title: 'Copy clone command',
            aria_label: 'Copy clone command'
        } only %}
    {% endif %}
    {% if empty %}
        <p class="notice">This repository is empty.</p>
    {% else %}
        <nav class="tabs" aria-label="Repository sections"><a class="active" href="#commands" data-tab="commands">Commands</a><a href="#readme" data-tab="readme">Readme</a>{% if canWrite or isAdmin %}<a href="#deployments" data-tab="deployments">Deployments{% if deployments is defined and deployments is not empty %} ({{ deployments|length }}){% endif %}</a>{% endif %}</nav>
        <section id="commands" class="section tab-content active" aria-label="SSH CLI Palette">
            <div class="cli-drawer">
                <div class="cli-drawer-header">
                    <span class="cli-drawer-title">
                        <span class="cli-prompt">&gt;_</span> SSH CLI Palette
                        <span class="cli-host">({{ sshPrefix }})</span>
                    </span>
                    <span class="cli-drawer-hint">
                        {% if isAdmin %}Admin access · full palette{% elseif canWrite %}Write access{% else %}Click any command to copy{% endif %} · <a href="/docs" style="color: inherit; text-decoration: underline;">Full Docs &rarr;</a>
                    </span>
                </div>
                <div class="cli-drawer-body">
                    <div class="cli-filter-bar">
                        <div class="cli-tabs" role="tablist">
                            <button type="button" class="cli-tab active" data-filter="all">All</button>
                            <button type="button" class="cli-tab" data-filter="explore">Explore</button>
                            <button type="button" class="cli-tab" data-filter="files">Files</button>
                            <button type="button" class="cli-tab" data-filter="git">Git</button>
                            {% if canWrite %}<button type="button" class="cli-tab" data-filter="write">Write</button>{% endif %}
                            {% if isAdmin %}<button type="button" class="cli-tab" data-filter="admin">Admin</button>{% endif %}
                        </div>
                        {% include 'components/filter_actions.html.twig' with {
                            placeholder: 'Filter commands (tree, grep, diff)...'
                        } only %}
                    </div>
                    <div class="cli-command-grid" data-prefix="{{ sshPrefix }}">
                        {% for item in cliCommands %}
                            <div class="cli-command-card{% if item.fields is not empty %} has-detail{% endif %}" data-category="{{ item.category }}" data-base="{{ item.base }}">
                                <div class="cli-card-info"{% if item.fields is not empty %} role="button" tabindex="0" aria-expanded="false" title="Click to edit arguments"{% endif %}>
                                    <span class="cli-card-title">{{ item.title }}{% if item.tier != 'read' %} <span class="cli-tier cli-tier-{{ item.tier }}">{{ item.tier }}</span>{% endif %}{% if item.fields is not empty %} <span class="cli-card-caret" aria-hidden="true">▸</span>{% endif %}</span>
                                    <span class="cli-card-desc">{{ item.description }}</span>
                                </div>
                                {% if item.fields is not empty %}
                                    <div class="cli-card-detail" hidden>
                                        {% for f in item.fields %}
                                            <label class="cli-field">
                                                <span class="cli-field-label">{{ f.label }}{% if f.required %} <abbr title="required" class="cli-req">*</abbr>{% endif %}<code class="cli-field-token">{{ f.flag ?: f.key }}</code></span>
                                                {% if f.kind == 'bool' %}
                                                    <input type="checkbox" class="cli-field-input" data-key="{{ f.key }}" data-kind="bool" data-flag="{{ f.flag }}"{% if f.default %} checked{% endif %}>
                                                {% elseif f.kind starts with 'choice' %}
                                                    <select class="cli-field-input" data-key="{{ f.key }}" data-kind="{{ f.kind }}" data-flag="{{ f.flag }}">
                                                        {% for c in f.choices %}<option value="{{ c }}"{% if c == f.default %} selected{% endif %}>{{ c }}</option>{% endfor %}
                                                    </select>
                                                {% else %}
                                                    <input type="text" class="cli-field-input" data-key="{{ f.key }}" data-kind="{{ f.kind }}" data-flag="{{ f.flag }}" placeholder="{{ f.placeholder }}" value="{{ f.default }}"{% if f.required %} data-required="1"{% endif %}>
                                                {% endif %}
                                            </label>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                <div class="cli-card-action" title="Click to copy command">
                                    <code class="cli-code">{{ item.command }}</code>
                                    {{ ui.copy_btn(item.command, 'Copy', '', 'Copy to clipboard', 'Copy ' ~ item.title ~ ' command') }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    {% if not isAdmin %}
                        <p class="cli-login-hint">Not seeing management commands? Run <code>{{ sshPrefix }} web login</code> {{ ui.copy_btn(sshPrefix ~ ' web login', null, 'copy-btn-sm', 'Copy login command') }} to authenticate this browser and unlock the actions you're allowed to run.</p>
                    {% endif %}
                </div>
            </div>
        </section>
        <section id="readme" class="section tab-content" aria-label="README">
            {% if readmePath is null %}
                <h2>README</h2>
                <p class="notice">This repository has no README.</p>
            {% else %}
                <h2>{{ readmePath }}</h2>
                <div class="readme">{{ readmeHtml }}</div>
            {% endif %}
        </section>
        {% if canWrite or isAdmin %}
            <section id="deployments" class="section tab-content" aria-label="Deployments">
                <div class="section-header" style="margin-top: 0;">
                    <h2>Docker Deployments</h2>
                    {% if deployments is defined and deployments is not empty %}
                        <span class="section-count">{{ deployments|length }}</span>
                    {% endif %}
                </div>
                {% if deployments is not defined or deployments is empty %}
                    <p class="notice">No deployment environments configured. Enable one via SSH: <code>{{ sshPrefix }} repo deploy enable {{ repository }} main</code></p>
                {% else %}
                    <div class="cli-command-grid" style="grid-template-columns: 1fr;">
                        {% for item in deployments %}
                            {% set env = item.environment %}
                            {% set rel = item.latestRelease %}
                            {% set quota = item.quota %}
                            <div class="cli-command-card deploy-card" data-href="/{{ repository }}/deployments/{{ env.refName }}" style="padding: 1rem 1.15rem;">
                                <a href="/{{ repository }}/deployments/{{ env.refName }}" class="deploy-card-link" aria-label="View deployment details for {{ env.refName }}"></a>
                                <div class="cli-card-info">
                                    <div class="deploy-card-top">
                                        <span class="cli-card-title" style="font-size: 1rem;">
                                            {{ env.refName }} ({{ env.refType.value }})
                                            <span class="cli-tier cli-tier-{{ env.status.value == 'running' ? 'public' : (env.status.value == 'failed' ? 'admin' : (env.status.value == 'building' ? 'write' : 'read')) }}">{{ env.status.value }}</span>
                                        </span>
                                        <span class="deploy-card-arrow" aria-hidden="true">&rarr;</span>
                                    </div>
                                    <span class="cli-card-desc" style="margin-top: 0.4rem;">
                                        Commit: <code>{{ env.deployedSha ? env.deployedSha|slice(0, 7) : 'none' }}</code>
                                        &middot; Quota: {{ quota.cpus }} CPU, {{ quota.memoryMb }}MB RAM, {{ quota.pids }} PIDs
                                    </span>
                                    {% if env.domains is not empty %}
                                        <span class="cli-card-desc">
                                            Domains:
                                            {% for d in env.domains %}
                                                <a href="https://{{ d.domain }}" target="_blank" rel="noopener noreferrer" class="deploy-nested-link">{{ d.domain }}</a> ({{ d.serviceName }}:{{ d.targetPort }}){% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        {% endif %}
    {% endif %}
{% endblock %}

{% block footer %}<footer class="status"><span class="status-name">{{ repository }}</span><span class="status-summary" id="status-summary">{{ empty ? 'empty repository' : 'Commands · HEAD' }}</span><span class="status-meta">HTTP · {{ serverName }}</span></footer>{% endblock %}
