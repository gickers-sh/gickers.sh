{% import 'macros/ui.html.twig' as ui %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ serverName }} - CLI Command Reference</title>
    <link rel="stylesheet" href="/css/repo-web.css">
    <script src="/js/repo-web.js" defer></script>
</head>
<body>
<main>
    <header class="repo-head home-header">
        <div class="identity">
            <h1 class="home-title"><a href="/" style="text-decoration: none; color: inherit;"><span class="cli-prompt">&gt;_</span> {{ serverName }}</a> <span class="cli-host">/ docs</span></h1>
            <p class="description">Command line reference and documentation for SSH CLI and web administration.</p>
        </div>
        {{ ui.user_nav(currentUsername, sshPrefix, 'docs') }}
    </header>

    <section class="section cli-palette-section" id="commands" aria-label="CLI Command Reference">
        <div class="cli-drawer-header">
            <span class="cli-drawer-title">
                <span class="cli-prompt">&gt;_</span> Command Catalog
                <span class="cli-host">({{ sshPrefix }})</span>
            </span>
            <span class="cli-drawer-hint">
                {{ commands|length }} commands · {% if isAdmin %}Admin access{% else %}Public & User scope{% endif %}
            </span>
        </div>
        <div class="cli-drawer-body">
            <div class="cli-filter-bar">
                <div class="cli-tabs" role="tablist">
                    <button type="button" class="cli-tab active" data-filter="all">All</button>
                    <button type="button" class="cli-tab" data-filter="explore">Explore</button>
                    <button type="button" class="cli-tab" data-filter="repo">Repositories</button>
                    <button type="button" class="cli-tab" data-filter="keys">Keys &amp; Tokens</button>
                    <button type="button" class="cli-tab" data-filter="identity">Identity</button>
                    {% if isAdmin %}
                        <button type="button" class="cli-tab" data-filter="admin">User Admin</button>
                        <button type="button" class="cli-tab" data-filter="settings">Server Settings</button>
                    {% endif %}
                </div>
                <div class="cli-filter-actions">
                    <input type="search" class="cli-search" placeholder="Filter commands (e.g. branch, pubkey, token)..." aria-label="Filter commands">
                    <div class="cli-view-toggle" role="group" aria-label="View layout">
                        <button type="button" class="cli-view-btn active" data-view="grid" title="Cards layout">Cards</button>
                        <button type="button" class="cli-view-btn" data-view="list" title="Compact list layout">List</button>
                    </div>
                </div>
            </div>

            <div class="cli-command-grid" data-prefix="{{ sshPrefix }}">
                {% for cmd in commands %}
                    <div class="cli-command-card has-detail" data-category="{{ cmd.category }}" data-base="{{ cmd.path }}">
                        <div class="cli-card-info" role="button" tabindex="0" aria-expanded="false" title="Click to view details and options">
                            <span class="cli-card-title">
                                <code>{{ cmd.path }}</code>
                                {% if cmd.tier != 'read' %}
                                    <span class="cli-tier cli-tier-{{ cmd.tier }}">{{ cmd.tier }}</span>
                                {% endif %}
                                <span class="cli-card-caret" aria-hidden="true">▸</span>
                            </span>
                            <span class="cli-card-desc">{{ cmd.short }}</span>
                        </div>
                        <div class="cli-card-detail" hidden>
                            {% if cmd.long is not empty %}
                                <div class="cli-detail-desc">{{ cmd.long }}</div>
                            {% endif %}

                            {% if cmd.flags is not empty %}
                                <div class="cli-detail-section">
                                    <span class="cli-detail-heading">Flags</span>
                                    <ul class="cli-flag-list">
                                        {% for flag in cmd.flags %}
                                            <li class="cli-flag-item">
                                                <code class="cli-flag-token">{% if flag.shorthand %}-{{ flag.shorthand }}, {% endif %}--{{ flag.name }}</code>
                                                {% if flag.varname %}<span class="cli-flag-type">{{ flag.varname }}</span>{% endif %}:
                                                <span>{{ flag.usage }}</span>
                                                {% if flag.default %}<span class="cli-flag-default">(default {{ flag.default }})</span>{% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}

                            {% if cmd.example is not empty %}
                                <div class="cli-detail-section cli-detail-example">
                                    <span class="cli-detail-heading">Example</span>
                                    <pre><code>{{ cmd.example }}</code></pre>
                                </div>
                            {% endif %}
                        </div>
                        <div class="cli-card-action" title="Click to copy command">
                            <code class="cli-code">{{ cmd.synopsis }}</code>
                            {{ ui.copy_btn(cmd.synopsis, 'Copy', 'copy-btn-sm', 'Copy command to clipboard') }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <footer class="status">
        <span class="status-name">{{ serverName }}</span>
        <span class="status-summary">Interactive Command Reference</span>
        <span class="status-meta">Centralized Catalog</span>
    </footer>
</main>
</body>
</html>
