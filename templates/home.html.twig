{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% set nav_page = 'home' %}

{% block header_identity %}
    <h1 class="home-title"><span class="cli-prompt">&gt;_</span> {{ serverName }}</h1>
    <p class="description">A tasty, self-hostable Git server for the command line.</p>
{% endblock %}

{% block main %}
    <section class="home-hero">
        <div class="hero-card">
            <div class="hero-main">
                <h2>Connect over SSH</h2>
                <p class="hero-desc">Explore repositories interactively with our terminal TUI or manage them via the command line.</p>
            </div>
            <div class="hero-command-box">
                <div class="clone-box hero-code-box" title="Click to copy SSH command">
                    <code class="clone-code">{{ sshPrefix }}</code>
                    {{ ui.copy_btn(sshPrefix, 'Copy', 'copy-btn-sm', 'Copy SSH command') }}
                </div>
            </div>
        </div>

        <div class="cli-command-grid">
            <div class="cli-command-card">
                <div class="cli-card-info">
                    <span class="cli-card-title">💻 Terminal TUI</span>
                    <span class="cli-card-desc">Interactive browser for branches, commits, files, and diffs right in your terminal.</span>
                </div>
                <div class="cli-card-action">
                    <code class="cli-code">{{ sshPrefix }}</code>
                </div>
            </div>
            <div class="cli-command-card">
                <div class="cli-card-info">
                    <span class="cli-card-title">🔑 SSH Web Login</span>
                    <span class="cli-card-desc">Zero password authentication. Mint a magic link with your SSH key to sign in.</span>
                </div>
                <div class="cli-card-action">
                    <code class="cli-code">{{ sshPrefix }} web login</code>
                </div>
            </div>
            <div class="cli-command-card">
                <div class="cli-card-info">
                    <span class="cli-card-title">📦 Create Repos</span>
                    <span class="cli-card-desc">Spin up new repositories instantly from your terminal or push on demand.</span>
                </div>
                <div class="cli-card-action">
                    <code class="cli-code">{{ sshPrefix }} repo create &lt;name&gt;</code>
                </div>
            </div>
        </div>
    </section>

    {% if currentUsername is null %}
        {% include 'components/auth_notice.html.twig' with {
            class: 'home-auth-notice',
            sshPrefix: sshPrefix
        } only %}
    {% endif %}

    <section class="home-repos-section" aria-label="Public repositories">
        <div class="section-header">
            <h2>Public Repositories</h2>
            <span class="section-count">{{ publicRepositories|length }}</span>
        </div>

        {% if publicRepositories is empty %}
            <div class="notice">
                <p>No public repositories published yet.</p>
                <p class="cli-login-hint">Create your first repository with <code>{{ sshPrefix }} repo create &lt;name&gt;</code> or push via Git.</p>
            </div>
        {% else %}
            <ul class="repo-list">
                {% for repo in publicRepositories %}
                    {% include 'components/repo_item.html.twig' with {
                        repo: repo,
                        show_public_badge: true
                    } only %}
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}

{% block footer_summary %}{{ publicRepositories|length }} public repositor{{ publicRepositories|length == 1 ? 'y' : 'ies' }}{% endblock %}
