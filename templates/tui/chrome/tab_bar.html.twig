<div class="tab-bar">
{% for i, label in labels %}
    {%- if not loop.first %} <span style="color: #3b4261;">│</span> {% endif -%}
    {%- if i == active -%}
        <span style="color: #7dcfff; text-decoration: underline;">{{ label }}</span>
    {%- else -%}
        <span style="color: #c0caf5;">{{ label }}</span>
    {%- endif -%}
{% endfor %}
</div>
