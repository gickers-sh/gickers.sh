{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}{{ cmd.path }} - {{ serverName }} CLI Reference{% endblock %}

{% set nav_page = 'docs' %}

{% block header_identity %}
    <nav class="repo-breadcrumb" aria-label="Breadcrumbs">
        <a href="/" class="breadcrumb-link"><span class="cli-prompt">&gt;_</span> {{ serverName }}</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/docs" class="breadcrumb-link">docs</a>
        {% for crumb in cmd.breadcrumbs %}
            <span class="breadcrumb-sep">/</span>
            {% if crumb.url %}
                <a href="{{ crumb.url }}" class="breadcrumb-link">{{ crumb.label }}</a>
            {% else %}
                <span class="breadcrumb-current">{{ crumb.label }}</span>
            {% endif %}
        {% endfor %}
    </nav>
{% endblock %}

{% block main %}
    <div class="doc-header-nav">
        <a href="{{ cmd.parentUrl ?: '/docs' }}" class="doc-back-btn">
            <span>&larr;</span> Back to {% if cmd.parentPath %}<code>{{ cmd.parentPath }}</code>{% else %}all commands{% endif %}
        </a>
    </div>

    <div class="doc-cmd-header">
        <div class="doc-title-row">
            <h1 class="doc-cmd-name"><code>{{ cmd.path }}</code></h1>
            <span class="doc-badge doc-badge-category">{{ cmd.category }}</span>
            {% if cmd.tier != 'read' %}
                <span class="cli-tier cli-tier-{{ cmd.tier }}">{{ cmd.tier }}</span>
            {% endif %}
            {% if cmd.isGroup %}
                <span class="doc-badge doc-badge-group">command group</span>
            {% endif %}
        </div>
        <p class="doc-subtitle">{{ cmd.short }}</p>
    </div>

    {% set leadText = cmd.doc.lead ?: (cmd.long != cmd.short ? cmd.long : '') %}
    {% if leadText is not empty %}
        <div class="doc-lead-card">
            <p class="doc-lead-text">{{ leadText }}</p>
        </div>
    {% endif %}

    {% if cmd.doc.scope %}
        {% include 'components/callout.html.twig' with {
            type: 'scope',
            icon: '🔒',
            title: 'Scope &amp; Access',
            text: cmd.doc.scope
        } only %}
    {% endif %}

    <section class="section" aria-label="Usage and Synopsis">
        <div class="section-header">
            <h2>Synopsis</h2>
        </div>
        <div class="doc-terminal">
            <div class="doc-terminal-bar">
                <div class="doc-terminal-header-left">
                    {% include 'components/terminal_dots.html.twig' %}
                    <span class="doc-terminal-title">CLI Syntax</span>
                </div>
                {{ ui.copy_btn(cmd.formalUse ?: cmd.synopsis, 'Copy command', '', 'Copy command to clipboard') }}
            </div>
            <div class="doc-terminal-body">
                <div class="doc-synopsis-line">
                    <span class="doc-term-prompt" aria-hidden="true">$</span>
                    <code class="doc-term-cmd">{{ cmd.formalUse ?: cmd.synopsis }}</code>
                </div>
                {% if cmd.formalUse and cmd.synopsis and cmd.formalUse != cmd.synopsis %}
                    <div class="doc-term-alias">
                        <span class="doc-term-alias-label">Base command:</span>
                        <code style="color: var(--cyan);">{{ cmd.synopsis }}</code>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    {% if cmd.doc.arguments is not empty %}
        <section class="section" aria-label="Arguments">
            <div class="section-header">
                <h2>Arguments</h2>
                <span class="section-count">{{ cmd.doc.arguments|length }}</span>
            </div>
            <div class="doc-params-card">
                <ul class="doc-params-list">
                    {% for arg in cmd.doc.arguments %}
                        <li class="doc-param-item">
                            <div class="doc-param-meta">
                                <code class="doc-param-name">{{ arg.name }}</code>
                                {% if arg.optional %}
                                    <span class="doc-param-badge opt">optional</span>
                                {% else %}
                                    <span class="doc-param-badge req">required</span>
                                {% endif %}
                            </div>
                            <div class="doc-param-desc">
                                {{ arg.description }}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    {% endif %}

    {% if cmd.subcommands is not empty %}
        <section class="section" aria-label="Subcommands">
            <div class="section-header">
                <h2>Subcommands</h2>
                <span class="section-count">{{ cmd.subcommands|length }}</span>
            </div>
            <div class="cli-command-grid">
                {% for sub in cmd.subcommands %}
                    {% include 'components/command_card.html.twig' with {
                        url: sub.url,
                        title_text: sub.path ~ ' command details',
                        name: sub.name,
                        tier: sub.tier,
                        description: sub.short,
                        command: sshPrefix ~ ' ' ~ sub.path,
                        btn_label: 'Copy',
                        btn_title: 'Copy command'
                    } only %}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if cmd.flags is not empty %}
        <section class="section" aria-label="Flags and options">
            <div class="section-header">
                <h2>Flags &amp; Options</h2>
                <span class="section-count">{{ cmd.flags|length }}</span>
            </div>
            <div class="doc-params-card">
                <ul class="doc-params-list">
                    {% for flag in cmd.flags %}
                        <li class="doc-param-item">
                            <div class="doc-param-meta">
                                <code class="cli-flag-token">{% if flag.shorthand %}-{{ flag.shorthand }}, {% endif %}--{{ flag.name }}</code>
                                {% if flag.varname %}
                                    <span class="cli-flag-type">&lt;{{ flag.varname }}&gt;</span>
                                {% endif %}
                            </div>
                            <div class="doc-param-desc">
                                <span>{{ flag.usage }}</span>
                                {% if flag.default %}
                                    <span class="doc-param-default">(default: <code>{{ flag.default }}</code>)</span>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    {% endif %}

    {% if cmd.example is not empty %}
        <section class="section" aria-label="Usage example">
            <div class="section-header">
                <h2>Example</h2>
            </div>
            <div class="doc-terminal">
                <div class="doc-terminal-bar">
                    <div class="doc-terminal-header-left">
                        {% include 'components/terminal_dots.html.twig' %}
                        <span class="doc-terminal-title">Usage Examples</span>
                    </div>
                    {{ ui.copy_btn(cmd.example, 'Copy example', 'copy-btn-sm', 'Copy example to clipboard') }}
                </div>
                <div class="doc-terminal-body" style="padding: 0.85rem 1.15rem;">
                    <pre class="doc-example-pre"><code>{% for line in cmd.example|split("\n") %}{% if line|trim starts with '#' %}<span class="doc-example-comment">{{ line }}</span>
{% elseif line|trim is empty %}

{% else %}<span class="doc-term-prompt">$</span> <span class="doc-example-cmd">{{ line|trim }}</span>
{% endif %}{% endfor %}</code></pre>
                </div>
            </div>
        </section>
    {% endif %}

    {% if cmd.doc.notes %}
        {% include 'components/callout.html.twig' with {
            type: 'notes',
            icon: '💡',
            title: 'Notes',
            text: cmd.doc.notes
        } only %}
    {% endif %}

    {% if cmd.doc.output %}
        {% include 'components/callout.html.twig' with {
            type: 'output',
            icon: '⚡',
            title: 'Output',
            text: cmd.doc.output
        } only %}
    {% endif %}
{% endblock %}

{% block footer_attrs %} style="margin-top: 2.5rem;"{% endblock %}
{% block footer_summary %}{{ cmd.path }} reference{% endblock %}
{% block footer_meta %}Centralized Catalog{% endblock %}
