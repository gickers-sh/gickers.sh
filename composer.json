{
    "name": "codes-sh/codes-sh",
    "description": "codes.sh: self-hostable Git server (Soft Serve port) on PHP and Symfony",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-ffi": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "codes-sh/termstrap": "@dev",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.3",
        "lcobucci/jwt": "^5.5",
        "symfony/cache": "8.1.*",
        "symfony/clock": "8.1.*",
        "symfony/config": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/error-handler": "8.1.*",
        "symfony/event-dispatcher": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/finder": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/password-hasher": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-core": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/stopwatch": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/tui": "8.1.*",
        "symfony/type-info": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/var-dumper": "8.1.*",
        "symfony/var-exporter": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.3",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0",
        "spaze/phpstan-disallowed-calls": "^4.15"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../termstrap",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "symfony": {
            "require": "8.1.*"
        }
    }
}
