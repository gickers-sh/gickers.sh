{
    "name": "codes-sh/tui",
    "description": "codes.sh TUI interactive client and Git repository browser in PHP with Symfony",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-ffi": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "lcobucci/jwt": "^5.5",
        "symfony/cache": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/error-handler": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/password-hasher": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-core": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/type-info": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/var-exporter": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Termstrap\\": "../termstrap/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    }
}
