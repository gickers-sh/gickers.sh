includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    tmpDir: var/phpstan
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
    # Configuration comes from ServerSettings (.env); only the codes-ssh dispatch contract reads the environment.
    disallowedFunctionCalls:
        -
            function: ['getenv()', 'putenv()']
            message: 'inject ServerSettings or an %env()% parameter instead'
            allowIn:
                - src/UI/Ssh/SshEntrypointCommand.php
                - src/UI/Ssh/Command/*
                - tests/*
    disallowedSuperglobals:
        -
            superglobal: ['$_SERVER', '$_ENV']
            message: 'inject ServerSettings or an %env()% parameter instead'
            allowIn:
                - src/UI/Ssh/SshEntrypointCommand.php
                - src/UI/Ssh/Command/*
                - tests/*
