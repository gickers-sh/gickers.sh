#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Point d'entrée `soft` : traduit la syntaxe Go (`soft admin migrate`, `soft hook update …`)
 * vers les commandes Symfony, puis délègue à bin/console via symfony/runtime.
 */

use App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

$args = array_slice($_SERVER['argv'], 1);

if ($args === ['-v'] || in_array('--version', $args, true)) {
    echo "soft version 1.0.0 (gickers.sh)\n";
    exit(0);
}

$mapped = match ($args[0] ?? null) {
    null => ['soft:browse'],
    'browse', 'serve', 'tui', 'man' => ['soft:'.$args[0], ...array_slice($args, 1)],
    'admin' => [...match ($args[1] ?? null) {
        null => ['list', 'soft:admin'],
        'migrate' => ['doctrine:migrations:migrate', '--no-interaction'],
        'rollback' => ['doctrine:migrations:migrate', 'prev', '--no-interaction'],
        default => ['soft:admin:'.$args[1]],
    }, ...array_slice($args, 2)],
    'hook' => isset($args[1]) ? ['soft:hook:'.$args[1], ...array_slice($args, 2)] : ['list', 'soft:hook'],
    default => $args,
};

$_SERVER['argv'] = [$_SERVER['argv'][0], ...$mapped];
$_SERVER['argc'] = count($_SERVER['argv']);

$projectDir = dirname(__DIR__);
$_SERVER['APP_RUNTIME_OPTIONS'] ??= $_ENV['APP_RUNTIME_OPTIONS'] ?? [];
if (is_string($_SERVER['APP_RUNTIME_OPTIONS'])) {
    $_SERVER['APP_RUNTIME_OPTIONS'] = json_decode($_SERVER['APP_RUNTIME_OPTIONS'], true, 512, JSON_THROW_ON_ERROR) ?? [];
}

// Precedence hierarchy (least to most priority):
// 1. .env (default baseline example)
// 2. .env.local (custom symfony dev overrides)
// 3. .env.docker (custom docker deployment overrides)
if (!is_file($projectDir.'/.env')) {
    $_SERVER['APP_RUNTIME_OPTIONS']['disable_dotenv'] = true;
}

$hasExplicitEnvArg = false;
foreach ($_SERVER['argv'] ?? [] as $arg) {
    if (str_starts_with($arg, '--env=') || str_starts_with($arg, '-e=') || $arg === '--env' || $arg === '-e') {
        $hasExplicitEnvArg = true;
        break;
    }
}

if (!$hasExplicitEnvArg && ('test' !== ($_SERVER['APP_ENV'] ?? $_ENV['APP_ENV'] ?? null)) && is_file($projectDir.'/.env.docker')) {
    $_SERVER['APP_RUNTIME_OPTIONS']['dotenv_overload'] = true;
    $_SERVER['APP_RUNTIME_OPTIONS']['dotenv_extra_paths'] ??= [];
    if (!in_array('.env.docker', $_SERVER['APP_RUNTIME_OPTIONS']['dotenv_extra_paths'], true)) {
        $_SERVER['APP_RUNTIME_OPTIONS']['dotenv_extra_paths'][] = '.env.docker';
    }
}

require_once dirname(__DIR__).'/vendor/autoload_runtime.php';

return static function (array $context): Application {
    $application = new Application(new Kernel($context['APP_ENV'], (bool) $context['APP_DEBUG']));
    $application->setName('soft');
    $application->setVersion('1.0.0');

    return $application;
};
