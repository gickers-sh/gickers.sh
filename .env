# Valeurs par défaut versionnées. Surcharges locales : .env.local (non versionné).
APP_ENV=dev
APP_SECRET=change-me-in-env-local
LOG_LEVEL=info

DATABASE_URL="sqlite:///%kernel.project_dir%/.data/codes-sh.db"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

SOFT_SERVE_NAME="Soft Serve"
SOFT_SERVE_SSH_LISTEN_ADDR=127.0.0.1:2223
SOFT_SERVE_SSH_PUBLIC_URL=ssh://localhost:2223
SOFT_SERVE_HTTP_LISTEN_ADDR=127.0.0.1:23232
SOFT_SERVE_HTTP_PUBLIC_URL=http://localhost:23232
SOFT_SERVE_LFS_ENABLED=true
SOFT_SERVE_ANON_ACCESS=read-only
SOFT_SERVE_ALLOW_KEYLESS=true
SOFT_SERVE_INITIAL_ADMIN_KEYS=
